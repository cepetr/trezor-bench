{
  "type": "gdb",
  "request": "launch",
  "name": "${tbench.debugProfileName}",
  "program": "${tbench.executablePath}",
  "unknownArg": "${tbench.nonExistentVariable}",
  "cwd": "${workspaceFolder}",
  "environment": [
    {
      "name": "TARGET",
      "value": "${tbench.target.id}"
    }
  ]
}
