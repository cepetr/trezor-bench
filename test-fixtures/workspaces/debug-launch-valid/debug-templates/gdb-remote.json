{
  // GDB remote debug template for firmware debugging
  "type": "gdb",
  "request": "launch",
  "name": "${tbench.debugProfileName} – ${tbench.model.id}/${tbench.component.id}",
  "program": "${tbench.executablePath}",
  "miDebuggerPath": "/usr/bin/arm-none-eabi-gdb",
  "miDebuggerServerAddress": "localhost:3333",
  "cwd": "${workspaceFolder}",
  "environment": [
    {
      "name": "TARGET",
      "value": "${tbench.target.id}"
    },
    {
      "name": "EXECUTABLE",
      "value": "${tbench.executable}"
    }
  ],
  "stopAtEntry": false,
  "hardwareBreakpoints": {
    "require": true,
    "limit": 8
  }
}
